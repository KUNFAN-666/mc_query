  "show_ping": { "type": "bool", "description": "是否显示 Ping(毫秒)。", "default": true },
  "show_online": { "type": "bool", "description": "是否显示在线人数。", "default": true },
  "show_version": { "type": "bool", "description": "是否显示版本(和核心)。", "default": true },
